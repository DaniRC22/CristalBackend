# ════════════════════════════════════════════════════════════
# Backend .env producción
# Copiar a /var/www/CristalBackend/.env y llenar con valores REALES
# ════════════════════════════════════════════════════════════

# ── Supabase (misma DB que dev por ahora) ──────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# ── MercadoPago (credenciales de PRODUCCIÓN) ───────────────
# Mientras el cliente no tenga MP, son las TUYAS.
# Swap futuro: solo reemplazar estos 2 valores y reiniciar pm2.
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxx
MP_WEBHOOK_SECRET=

# Nombre que se usa en metadata.source de las preferences MP.
# Validado en el webhook como defensa en profundidad.
MP_APP_NAME=

# HMAC del webhook MP en modo strict (rechaza si falla la firma).
# Default false (soft): loguea warning y valida solo con API de MP.
# Activar true cuando MP confirme que el secret del panel funciona.
MP_WEBHOOK_HMAC_STRICT=false

# ── URLs públicas ──────────────────────────────────────────
FRONTEND_URL=
BACKEND_URL=

# ── Puerto interno (nginx hace proxy desde 443) ────────────
PORT=4000
